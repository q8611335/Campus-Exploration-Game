modules = ["python-3.11", "java", "java-graalvm22.3"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Campus Navigator"

[[workflows.workflow]]
name = "Campus Navigator"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd src && java CampusNavigatorEngine 5 5 123 ../data/maps/southbank.txt ../data/events/events_southbank.txt"

[workflows.workflow.metadata]
outputType = "console"
